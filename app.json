{
  "expo": {
    "name": "Ultra Cast v3",
    "slug": "stream-master",
    "owner": "mgcultra",
    "version": "1.3.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "iptvplayer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iptv.player"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.iptv.player",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0E27",
          "dark": {
            "backgroundColor": "#0A0E27"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24,
            "packagingOptions": {
              "pickFirsts": [
                "lib/x86/libc++_shared.so",
                "lib/x86_64/libc++_shared.so",
                "lib/armeabi-v7a/libc++_shared.so",
                "lib/arm64-v8a/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withVlcMinSdkOverride",
      [
        "./plugins/withTvBanner",
        { "bannerPath": "./assets/images/tv-banner.png" }
      ],
      [
        "react-native-vlc-media-player",
        { "ios": { "includeVLCKit": false } }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://stream-master--matt2k88.replit.app",
      "eas": {
        "projectId": "5584f3b5-d394-4b4d-becd-3d1f20cfb755"
      }
    }
  }
}
