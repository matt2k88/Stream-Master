<?xml version="1.0" encoding="utf-8"?>
<!--
  Root is a FrameLayout so the SurfaceView sits directly on top of the
  WebView. The SurfaceView is GONE until setFullscreen(true) is called
  from JS — at that point it becomes VISIBLE and covers the entire screen,
  giving the native player a dedicated rendering surface while the WebView
  (and its JS/UI) remain alive underneath.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      SurfaceView for native video rendering (LibVLC IVLCVout / ExoPlayer
      surface). Kept GONE until fullscreen is requested by JS so it does
      not intercept touch events while the web UI is in control.
    -->
    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
